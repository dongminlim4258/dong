<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>서울 지하철 스마트 도서관 지도</title>
    <style>
        body, html { margin: 0; padding: 0; height: 100%; width: 100%; font-family: 'Malgun Gothic', sans-serif; }
        #map { width: 100%; height: 100vh; }

        /* 하단 네비게이션 디자인 (딥 블루 적용) */
        .bottom-nav {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 15px;
            z-index: 100;
        }
        .bottom-nav button {
            padding: 12px 25px;
            border-radius: 50px;
            border: none;
            background: #10069F; /* 동민님이 선택하신 딥 블루 */
            color: white;
            font-size: 16px;
            font-weight: bold;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            cursor: pointer;
            transition: 0.3s;
        }
        .bottom-nav button:hover {
            background: #0a046b;
            transform: translateY(-2px);
        }

        /* 말풍선(InfoWindow) 스타일 */
        .info-window {
            padding: 10px;
            font-size: 14px;
            font-weight: bold;
            color: #10069F;
            text-align: center;
        }
    </style>
</head>
<body>

    <div id="map"></div>

    <div class="bottom-nav">
        <button onclick="alert('자료 검색 기능을 준비 중입니다!')">🔍 자료 검색</button>
        <button onclick="alert('이용안내 페이지로 이동합니다.')">📖 이용안내</button>
    </div>

    <script type="text/javascript" src="//dapi.kakao.com/v2/maps/sdk.js?appkey=여기에_자바스크립트_키_입력"></script>
    
    <script>
        var mapContainer = document.getElementById('map'); 
        var mapOption = { 
            center: new kakao.maps.LatLng(37.5665, 126.9780), 
            level: 7 
        };

        var map = new kakao.maps.Map(mapContainer, mapOption); 

        // 1. 내 위치 찾기 (GPS)
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function(position) {
                var lat = position.coords.latitude;
                var lon = position.coords.longitude;
                var locPosition = new kakao.maps.LatLng(lat, lon);
                map.setCenter(locPosition);
            });
        }

        // 2. 스마트 도서관 전체 데이터 (83개소)
        var libraryData = [{"title": "수서역 스마트도서관 (3호선)", "lat": 37.487507, "lng": 127.101324}, {"title": "청담역 스마트도서관 (7호선)", "lat": 37.519097, "lng": 127.051851}, {"title": "압구정역 스마트도서관 (3호선)", "lat": 37.526169, "lng": 127.028502}, {"title": "천호역 스마트도서관 (8호선)", "lat": 37.53792, "lng": 127.123179}, {"title": "상일동역 스마트도서관 (5호선)", "lat": 37.556714, "lng": 127.166381}, {"title": "고덕역 스마트도서관 (5호선)", "lat": 37.555002, "lng": 127.154214}, {"title": "수유역 스마트도서관 (4호선)", "lat": 37.637127, "lng": 127.024731}, {"title": "미아역 스마트도서관 (4호선)", "lat": 37.626435, "lng": 127.026151}, {"title": "미아사거리역 스마트도서관 (4호선)", "lat": 37.613276, "lng": 127.030083}, {"title": "마곡역 스마트도서관 (5호선)", "lat": 37.562182, "lng": 126.82693}, {"title": "우장산역 스마트도서관 (5호선)", "lat": 37.548487, "lng": 126.836067}, {"title": "강서구청역 스마트도서관 (5호선)", "lat": 37.550853, "lng": 126.849495}, {"title": "까치산역 스마트도서관 (2호선,5호선)", "lat": 37.532306, "lng": 126.846313}, {"title": "마곡나루역 스마트도서관 (9호선)", "lat": 37.565314, "lng": 126.827285}, {"title": "봉천역 스마트도서관 (2호선)", "lat": 37.482362, "lng": 126.941892}, {"title": "서울대입구역 스마트도서관 (2호선)", "lat": 37.481247, "lng": 126.952739}, {"title": "신림역 스마트도서관 (2호선)", "lat": 37.48422, "lng": 126.929715}, {"title": "광진구청역 스마트도서관 (2호선)", "lat": 37.539233, "lng": 127.070974}, {"title": "건대입구역 스마트도서관 (2,7호선)", "lat": 37.540693, "lng": 127.07023}, {"title": "구의역 스마트도서관 (2호선)", "lat": 37.537077, "lng": 127.085916}, {"title": "군자역 스마트도서관 (5,7호선)", "lat": 37.557159, "lng": 127.079543}, {"title": "온수(성공회대입구)역 스마트도서관 (7호선)", "lat": 37.492059, "lng": 126.823294}, {"title": "개봉역 스마트도서관 (1호선)", "lat": 37.494525, "lng": 126.858362}, {"title": "오류동역 스마트도서관 (1호선)", "lat": 37.494525, "lng": 126.844702}, {"title": "가산디지털단지역역 스마트도서관 (7호선)", "lat": 37.480376, "lng": 126.882704}, {"title": "독산역 스마트도서관 (1호선)", "lat": 37.468641, "lng": 126.889154}, {"title": "금천구청역 스마트도서관 (1호선)", "lat": 37.456041, "lng": 126.894819}, {"title": "공릉역 스마트도서관 (7호선)", "lat": 37.625742, "lng": 127.073017}, {"title": "석계역 스마트도서관 (1,6호선)", "lat": 37.615174, "lng": 127.065406}, {"title": "태릉입구역 스마트도서관 (6,7호선)", "lat": 37.617303, "lng": 127.07505}, {"title": "상도역 스마트도서관 (7호선)", "lat": 37.502844, "lng": 126.947936}, {"title": "장승배기역역 스마트도서관 (7호선)", "lat": 37.504845, "lng": 126.939025}, {"title": "신대방삼거리역역 스마트도서관 (7호선)", "lat": 37.499717, "lng": 126.928218}, {"title": "공덕역 스마트도서관 (5,6호선)", "lat": 37.544018, "lng": 126.951592}, {"title": "합정역 스마트도서관 (2,6호선)", "lat": 37.549463, "lng": 126.912387}, {"title": "월드컵경기장역 스마트도서관 (6호선)", "lat": 37.569543, "lng": 126.899298}, {"title": "응암역 스마트도서관 (6호선)", "lat": 37.598605, "lng": 126.915577}, {"title": "수색역 스마트도서관 (경의중앙선)", "lat": 37.580795, "lng": 126.895514}, {"title": "디지털미디어시티역 스마트도서관 (6호선)", "lat": 37.576722, "lng": 126.901174}, {"title": "DMC역 스마트도서관 (6호선)", "lat": 37.576722, "lng": 126.901174}, {"title": "증산역 스마트도서관 (6호선)", "lat": 37.583871, "lng": 126.913951}, {"title": "망원역 스마트도서관 (6호선)", "lat": 37.555979, "lng": 126.910714}, {"title": "상수역 스마트도서관 (6호선)", "lat": 37.547731, "lng": 126.92283}, {"title": "광흥창역 스마트도서관 (6호선)", "lat": 37.547456, "lng": 126.931993}, {"title": "대흥역 스마트도서관 (6호선)", "lat": 37.547709, "lng": 126.942379}, {"title": "마포역 스마트도서관 (5호선)", "lat": 37.539175, "lng": 126.945145}, {"text": "애오개역 스마트도서관 (5호선)", "lat": 37.553736, "lng": 126.956414}, {"title": "답십리역 스마트도서관 (5호선)", "lat": 37.56234, "lng": 127.050608}, {"title": "장한평역 스마트도서관 (5호선)", "lat": 37.561448, "lng": 127.064567}, {"title": "동대문구청역 스마트도서관 (2호선)", "lat": 37.574447, "lng": 127.03975}, {"title": "동대문역 스마트도서관 (1,4호선)", "lat": 37.57142, "lng": 127.009745}, {"title": "방학역 스마트도서관 (1호선)", "lat": 37.667503, "lng": 127.04423}, {"title": "창동역 스마트도서관 (1,4호선)", "lat": 37.653186, "lng": 127.047683}, {"title": "쌍문역 스마트도서관 (4호선)", "lat": 37.648932, "lng": 127.034731}, {"title": "도봉역 스마트도서관 (1호선)", "lat": 37.679522, "lng": 127.045547}, {"title": "사당역 스마트도서관 (2,4호선)", "lat": 37.47653, "lng": 126.981685}, {"title": "이수역 스마트도서관 (4,7호선)", "lat": 37.486263, "lng": 126.981989}, {"title": "남성역 스마트도서관 (7호선)", "lat": 37.484596, "lng": 126.971279}, {"title": "내방역 스마트도서관 (7호선)", "lat": 37.487618, "lng": 126.993717}, {"title": "왕십리역 스마트도서관 (2,5호선)", "lat": 37.561238, "lng": 127.037102}, {"title": "옥수역 스마트도서관 (3호선)", "lat": 37.541528, "lng": 127.017382}, {"title": "금호역 스마트도서관 (3호선)", "lat": 37.548034, "lng": 127.01584}, {"title": "성수역 스마트도서관 (2호선)", "lat": 37.544581, "lng": 127.055961}, {"title": "길음역 스마트도서관 (4호선)", "lat": 37.603407, "lng": 127.025005}, {"title": "한성대입구역 스마트도서관 (4호선)", "lat": 37.588458, "lng": 127.006221}, {"title": "월곡역 스마트도서관 (6호선)", "lat": 37.601948, "lng": 127.041518}, {"title": "보문역 스마트도서관 (6호선)", "lat": 37.585286, "lng": 127.019381}, {"title": "돌곶이역 스마트도서관 (6호선)", "lat": 37.610637, "lng": 127.056431}, {"title": "상월곡역 스마트도서관 (6호선)", "lat": 37.60637, "lng": 127.048491}, {"title": "고려대역 스마트도서관 (6호선)", "lat": 37.590508, "lng": 127.036296}, {"title": "안암역 스마트도서관 (6호선)", "lat": 37.586272, "lng": 127.029005}, {"title": "성북구청역 스마트도서관 (4호선)", "lat": 37.582844, "lng": 127.013439}, {"title": "성신여대역 스마트도서관 (4호선)", "lat": 37.592624, "lng": 127.016403}, {"title": "여의나루역 스마트도서관 (5호선)", "lat": 37.527098, "lng": 126.932901}, {"title": "신길역 스마트도서관 (1,5호선)", "lat": 37.517122, "lng": 126.917169}, {"title": "영등포구청역 스마트도서관 (2,5호선)", "lat": 37.52497, "lng": 126.895951}, {"title": "오금역 스마트도서관 (3,5호선)", "lat": 37.503048, "lng": 127.128415}, {"title": "거여역 스마트도서관 (5호선)", "lat": 37.493105, "lng": 127.14358}, {"title": "마천역 스마트도서관 (5호선)", "lat": 37.497576, "lng": 127.152864}, {"title": "시청역 스마트도서관 (1,2호선)", "lat": 37.564718, "lng": 126.977108}, {"title": "중화역 스마트도서관 (7호선)", "lat": 37.602545, "lng": 127.079261}, {"title": "신내역 스마트도서관 (6호선)", "lat": 37.612887, "lng": 127.103218}, {"title": "망우역 스마트도서관 (경의중앙선)", "lat": 37.59955, "lng": 127.091905}];

        // 3. 지도에 마커 찍기 및 클릭 이벤트 설정
        for (var i = 0; i < libraryData.length; i ++) {
            var marker = new kakao.maps.Marker({
                map: map, 
                position: new kakao.maps.LatLng(libraryData[i].lat, libraryData[i].lng),
                title : libraryData[i].title
            });

            // 마커 클릭 시 이름 보여주기
            (function(marker, title) {
                kakao.maps.event.addListener(marker, 'click', function() {
                    var infowindow = new kakao.maps.InfoWindow({
                        content: '<div class="info-window">' + title + '</div>',
                        removable: true
                    });
                    infowindow.open(map, marker);
                });
            })(marker, libraryData[i].title);
        }
    </script>
</body>
</html>

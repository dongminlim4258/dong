<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>지하철 스마트 도서관 지도</title>
    <style>
        /* [CSS] 디자인을 담당하는 부분 */
        body, html { margin: 0; padding: 0; height: 100%; width: 100%; }
        #map { width: 100%; height: 100vh; }

        /* 따릉이 스타일 하단 네비게이션 */
        .bottom-nav {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 15px;
            z-index: 100;
        }
        .bottom-nav button {
            padding: 12px 25px;
            border-radius: 50px;
            border: none;
            background: #10069F; /* 따릉이 초록색 */
            color: white;
            font-size: 16px;
            font-weight: bold;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            cursor: pointer;
        }
    </style>
</head>
<body>

    <div id="map"></div>

    <div class="bottom-nav">
        <button onclick="alert('자료 검색 기능을 준비 중입니다!')">🔍 자료 검색</button>
        <button onclick="alert('이용안내 페이지로 이동합니다.')">📖 이용안내</button>
    </div>

    <script type="text/javascript" src="//dapi.kakao.com/v2/maps/sdk.js?appkey=35b5b863774f0cef13d397c765007386"></script>
    
    <script>
        var mapContainer = document.getElementById('map'); 
        var mapOption = { 
            center: new kakao.maps.LatLng(37.5665, 126.9780), // 기본 중심 (서울시청)
            level: 4 
        };

        var map = new kakao.maps.Map(mapContainer, mapOption); 

        // 1. 내 위치 찾기
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function(position) {
                var lat = position.coords.latitude;
                var lon = position.coords.longitude;
                var locPosition = new kakao.maps.LatLng(lat, lon);
                map.setCenter(locPosition); // 지도를 내 위치로 이동
            });
        }

        // 2. 스마트 도서관 데이터 (나중에 실제 데이터 파일로 교체할 부분)
        var positions = [
            { title: '상봉역 스마트도서관', latlng: new kakao.maps.LatLng(37.5956, 127.0861) },
            { title: '면목역 스마트도서관', latlng: new kakao.maps.LatLng(37.5886, 127.0871) },
            { title: '중화역 스마트도서관', latlng: new kakao.maps.LatLng(37.6022, 127.0792) }
        ];

        // 3. 지도에 마커(핀) 표시하기
        for (var i = 0; i < positions.length; i ++) {
            var marker = new kakao.maps.Marker({
                map: map, 
                position: positions[i].latlng,
                title : positions[i].title
            });
        }
    </script>
</body>
</html>